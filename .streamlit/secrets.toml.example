# Copy to .streamlit/secrets.toml (git-ignored) for local use, or paste into
# Streamlit Community Cloud: Manage app -> Settings -> Secrets.
# Placeholders only. Never commit real values.

[auth]
session_timeout_minutes = 480

# Break-glass admin: always works, even if the Google Sheet is unavailable.
# Create the hash with: python scripts/hash_password.py
[auth.admin]
username = "admin"
name = "Dashboard Admin"
password_hash = "$2b$12$REPLACE_WITH_OUTPUT_OF_hash_password.py"

# Google Sheet holding the "users" worksheet (and feedback in Phase 4).
# Leave this block out to use the local SQLite fallback (data/users/users.db).
[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"
